
<?php

// =====================================================
// CONFIGURATION
// =====================================================

$protocol = 'http';
$port     = '8080';
$address  = '127.0.0.1';

$root     = __DIR__;
$frontend = $root . '/public';
$backend  = $root . '/index.php';

// =====================================================
// SERVER STARTER
// =====================================================

if (PHP_SAPI === 'cli') {

    foreach ($argv as $arg) {
        $e = explode('=', $arg, 2);

        if ($e[0] === '--address' && isset($e[1])) {
            $address = $e[1];
        }

        if ($e[0] === '--port' && isset($e[1])) {
            $port = $e[1];
        }
    }

    echo "PHP Native Server Started at $protocol://$address:$port\n";

    $cmd = sprintf(
        '%s -S %s:%s -t %s %s',
        escapeshellarg(PHP_BINARY),
        escapeshellarg($address),
        escapeshellarg($port),
        escapeshellarg($root),
        escapeshellarg(__FILE__)
    );

    passthru($cmd);
    exit;
}

// =====================================================
// REQUEST HANDLER
// =====================================================

$path = rawurldecode(
    parse_url($_SERVER['REQUEST_URI'], PHP_URL_PATH)
);

// =====================================================
// BACKEND
// =====================================================

if ($path === '/api' || str_starts_with($path, '/api/')) {

    $_SERVER['REQUEST_URI'] = substr($path, 4) ?: '/';
    $_SERVER['SCRIPT_NAME'] = '/index.php';
    $_SERVER['SCRIPT_FILENAME'] = $backend;
    $_SERVER['PHP_SELF'] = '/index.php';

    require $backend;
    return true;
}

// =====================================================
// FRONTEND STATIC FILES
// =====================================================

$frontendReal = realpath($frontend);

$file = realpath(
    $frontendReal . DIRECTORY_SEPARATOR . ltrim($path, '/')
);

if (
    $file !== false &&
    str_starts_with($file, $frontendReal . DIRECTORY_SEPARATOR) &&
    is_file($file)
) {
    $extension = strtolower(pathinfo($file, PATHINFO_EXTENSION));

    $mimeTypes = [
        'html'        => 'text/html; charset=UTF-8',
        'css'         => 'text/css; charset=UTF-8',
        'js'          => 'application/javascript; charset=UTF-8',
        'mjs'         => 'application/javascript; charset=UTF-8',
        'json'        => 'application/json; charset=UTF-8',
        'svg'         => 'image/svg+xml',
        'png'         => 'image/png',
        'jpg'         => 'image/jpeg',
        'jpeg'        => 'image/jpeg',
        'webp'        => 'image/webp',
        'ico'         => 'image/x-icon',
        'woff'        => 'font/woff',
        'woff2'       => 'font/woff2',
        'ttf'         => 'font/ttf',
    ];

    $mime = $mimeTypes[$extension] ?? 'application/octet-stream';

    if (ob_get_level() > 0) {
        ob_clean();
    }

    header('Content-Type: ' . $mime);
    header('Content-Length: ' . filesize($file));
    header('Cache-Control: no-cache');

    $handle = fopen($file, 'rb');

    if ($handle === false) {
        http_response_code(500);
        return true;
    }

    fpassthru($handle);
    fclose($handle);

    return true;
}

// =====================================================
// SPA FALLBACK
// =====================================================

if (pathinfo($path, PATHINFO_EXTENSION) !== '') {
    http_response_code(404);
    echo 'Asset Not Found';
    return true;
}

require $frontend . '/index.html';

return true;
