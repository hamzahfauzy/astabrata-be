
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        :root {
            --bs-body-font-family: 'Inter', sans-serif;
            --primary-blue: #1d4ed8;
            --primary-soft: #eff6ff;
            --bg-canvas: #f8fafc;
            --border-color: #e2e8f0;
        }

        /* Card Styles */
        .card-custom {
            border: 1px solid var(--border-color);
            border-radius: 12px;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05);
            background-color: #ffffff;
            transition: all 0.2s ease;
        }

        /* Top Stat Cards */
        .stat-card {
            padding: 1.25rem;
            display: flex;
            align-items: center;
            gap: 1rem;
        }
        .stat-icon {
            width: 52px;
            height: 52px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            flex-shrink: 0;
        }
        .stat-icon-blue { background-color: #dbeafe; color: #1d4ed8; }
        .stat-icon-orange { background-color: #ffedd5; color: #ea580c; }
        .stat-icon-yellow { background-color: #fef9c3; color: #ca8a04; }
        .stat-icon-green { background-color: #dcfce7; color: #16a34a; }

        .stat-val {
            font-size: 1.75rem;
            font-weight: 700;
            line-height: 1.2;
        }
        .stat-label {
            font-size: 0.8rem;
            color: #64748b;
            font-weight: 500;
        }

        /* Process Flow Section */
        .flow-step {
            display: flex;
            align-items: flex-start;
            gap: 0.75rem;
        }
        .step-number {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background-color: #e2e8f0;
            color: #475569;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.85rem;
            flex-shrink: 0;
        }
        .step-icon-box {
            font-size: 1.75rem;
            color: #2563eb;
            margin-bottom: 0.25rem;
        }
        .flow-arrow {
            color: #cbd5e1;
            font-size: 1.25rem;
            margin-top: 1.25rem;
        }

        /* Status & Proof Badges */
        .badge-status {
            padding: 0.35em 0.75em;
            font-weight: 600;
            font-size: 0.75rem;
            border-radius: 6px;
            display: inline-block;
        }
        .badge-terjadwal { background-color: #dbeafe; color: #1e40af; }
        .badge-ditelaah { background-color: #ffedd5; color: #c2410c; }
        .badge-selesai { background-color: #dcfce7; color: #15803d; }
        .badge-belum { background-color: #ffe4e6; color: #be123c; }
        .badge-lengkap { background-color: #dcfce7; color: #15803d; }

        /* Table Customizations */
        .table-custom {
            margin-bottom: 0;
        }
        .table-custom th {
            background-color: #f8fafc;
            color: #475569;
            font-weight: 600;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.025em;
            padding: 0.85rem 0.75rem;
            border-bottom: 1px solid var(--border-color);
        }
        .table-custom td {
            vertical-align: middle;
            padding: 0.85rem 0.75rem;
            border-bottom: 1px solid #f1f5f9;
        }
        .table-custom tbody tr:hover {
            background-color: #f8fafc;
            cursor: pointer;
        }
        .table-custom tbody tr.table-active-row {
            background-color: #eff6ff !important;
        }

        /* Drag and Drop Zone */
        .upload-box {
            border: 2px dashed #cbd5e1;
            border-radius: 8px;
            padding: 1.25rem;
            text-align: center;
            background-color: #f8fafc;
            cursor: pointer;
            transition: all 0.2s;
        }
        .upload-box:hover {
            border-color: #3b82f6;
            background-color: #eff6ff;
        }

        /* Info Alert Box */
        .info-alert {
            background-color: #eff6ff;
            border: 1px solid #bfdbfe;
            color: #1e40af;
            border-radius: 8px;
            padding: 0.75rem 1rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-size: 0.825rem;
        }
        .info-alert i {
            font-size: 1.2rem;
            color: #2563eb;
        }

        /* Key Value Details */
        .detail-kv-row {
            display: flex;
            margin-bottom: 0.4rem;
            font-size: 0.825rem;
        }
        .detail-kv-key {
            width: 110px;
            color: #64748b;
            flex-shrink: 0;
        }
        .detail-kv-val {
            font-weight: 600;
            color: #0f172a;
        }

        /* Form Labels Required */
        .form-label-required::after {
            content: " *";
            color: #ef4444;
        }

        .btn-action-outline {
            border: 1px solid #2563eb;
            color: #2563eb;
            border-radius: 6px;
            padding: 3px 12px;
            font-size: 0.785rem;
            font-weight: 500;
            background: #ffffff;
            transition: all 0.2s;
        }

        .btn-action-outline:hover {
            background-color: #2563eb;
            color: #ffffff;
        }
    </style>
    

    <div class="container-fluid p-0">
        
        <!-- Header Title Section -->
        <div class="mb-4">
            <h2 class="fw-bold text-primary-dark mb-1" style="color: #0f172a; font-size: 1.8rem;">Beranda OPD/PIC</h2>
            <p class="text-muted mb-0">Tindak lanjut rujukan dan pelaksanaan intervensi KPM sesuai kewenangan OPD.</p>
        </div>

        <div class="row g-4">
            <!-- LEFT MAIN CONTAINER (Stat Cards, Process Flow, Table) -->
            <div class="col-lg-8">
                
                <div class="row g-3 mb-4">
                    <!-- Stat Card 1 -->
                    <div class="col-sm-6 col-md-3">
                        <div class="card-custom stat-card">
                            <div class="stat-icon stat-icon-blue">
                                <i class="bi bi-file-earmark-text-fill"></i>
                            </div>
                            <div>
                                <div class="stat-label">Rujukan Masuk</div>
                                <div class="stat-val text-primary" id="stat-masuk">{{data.totalProfile}}</div>
                            </div>
                        </div>
                    </div>
                    <!-- Stat Card 2 -->
                    <div class="col-sm-6 col-md-3">
                        <div class="card-custom stat-card">
                            <div class="stat-icon stat-icon-orange">
                                <i class="bi bi-file-earmark-search-fill"></i>
                            </div>
                            <div>
                                <div class="stat-label">Perlu Ditelaah</div>
                                <div class="stat-val text-warning" id="stat-ditelaah">{{data.totalProfileNeedCheck}}</div>
                            </div>
                        </div>
                    </div>
                    <!-- Stat Card 3 -->
                    <div class="col-sm-6 col-md-3">
                        <div class="card-custom stat-card">
                            <div class="stat-icon stat-icon-yellow">
                                <i class="bi bi-calendar-event-fill"></i>
                            </div>
                            <div>
                                <div class="stat-label">Terjadwal</div>
                                <div class="stat-val text-warning" id="stat-terjadwal" style="color: #ca8a04 !important;">{{data.totalProfileScheduled}}</div>
                            </div>
                        </div>
                    </div>
                    <!-- Stat Card 4 -->
                    <div class="col-sm-6 col-md-3">
                        <div class="card-custom stat-card">
                            <div class="stat-icon stat-icon-green">
                                <i class="bi bi-check-circle-fill"></i>
                            </div>
                            <div>
                                <div class="stat-label">Intervensi Selesai</div>
                                <div class="stat-val text-success" id="stat-selesai">{{data.totalProfileDone}}</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-custom p-3 mb-4">
                    <h6 class="fw-bold mb-3" style="color: #1e293b;">Alur Tindak Lanjut OPD</h6>
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                        <!-- Step 1 -->
                        <div class="flow-step align-items-center">
                            <div class="step-number">1</div>
                            <div>
                                <div class="step-icon-box"><i class="bi bi-file-earmark-text"></i></div>
                                <div class="fw-bold text-dark" style="font-size: 0.85rem;">Terima Rujukan</div>
                                <div class="text-muted" style="font-size: 0.725rem; max-width: 140px;">Menerima rujukan digital dari Dinas Sosial</div>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right flow-arrow d-none d-md-block"></i>
                        
                        <!-- Step 2 -->
                        <div class="flow-step align-items-center">
                            <div class="step-number">2</div>
                            <div>
                                <div class="step-icon-box"><i class="bi bi-calendar-range"></i></div>
                                <div class="fw-bold text-dark" style="font-size: 0.85rem;">Telaah dan Jadwalkan</div>
                                <div class="text-muted" style="font-size: 0.725rem; max-width: 140px;">Menelaah kebutuhan dan menetapkan program/kegiatan serta jadwal</div>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right flow-arrow d-none d-md-block"></i>

                        <!-- Step 3 -->
                        <div class="flow-step align-items-center">
                            <div class="step-number">3</div>
                            <div>
                                <div class="step-icon-box"><i class="bi bi-gear-fill"></i></div>
                                <div class="fw-bold text-dark" style="font-size: 0.85rem;">Laksanakan Intervensi</div>
                                <div class="text-muted" style="font-size: 0.725rem; max-width: 140px;">Melaksanakan layanan, fasilitasi, pendampingan, atau pelatihan</div>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right flow-arrow d-none d-md-block"></i>

                        <!-- Step 4 -->
                        <div class="flow-step align-items-center">
                            <div class="step-number">4</div>
                            <div>
                                <div class="step-icon-box"><i class="bi bi-bar-chart-line-fill"></i></div>
                                <div class="fw-bold text-dark" style="font-size: 0.85rem;">Laporkan Realisasi</div>
                                <div class="text-muted" style="font-size: 0.725rem; max-width: 140px;">Mencatat hasil, mengunggah bukti, dan memperbarui status rujukan</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-custom p-3 mb-3">
                    <!-- Table Header Controls -->
                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-3">
                        <h6 class="fw-bold mb-0" style="color: #1e293b;">Daftar Rujukan KPM</h6>
                        <div class="d-flex gap-2">
                            <div class="input-group input-group-sm" style="max-width: 320px;">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                                <input type="text" id="searchInput" class="form-control bg-light border-start-0" placeholder="Cari nomor rujukan, nama KPM, kebutuhan, atau status">
                            </div>
                            <button class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1">
                                <i class="bi bi-funnel"></i> Filter <i class="bi bi-chevron-down ms-1" style="font-size: 0.7rem;"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Data Table -->
                    <div class="table-responsive">
                        <table class="table table-custom align-middle" id="rujukanTable">
                            <thead>
                                <tr>
                                    <th class="text-nowrap">No. Rujukan</th>
                                    <th class="text-nowrap">Nama KPM</th>
                                    <th class="text-nowrap">Kebutuhan</th>
                                    <th class="text-nowrap">Program/Kegiatan</th>
                                    <th class="text-nowrap">Target Waktu</th>
                                    <th class="text-nowrap">Status</th>
                                    <th class="text-nowrap">Bukti</th>
                                    <th>Aksi</th>
                                </tr>
                            </thead>
                            <tbody id="tableBody">
                                @for(const profile of data.profiles)
                                <tr>
                                    <td class="fw-medium text-secondary" style="font-size: 0.825rem;">RJ-2026-{{profile.id}}</td>
                                    <td class="fw-bold text-dark" style="font-size: 0.825rem;">{{profile.name}}</td>
                                    <td class="text-uppercase text-secondary text-nowrap" style="font-size: 0.825rem;">
                                        {{profile.stage_name == 'stage_5' ? profile.stage_data.analysis : 'Belum Ditelaah'}}
                                    </td>
                                    <td class="text-uppercase text-secondary text-nowrap" style="font-size: 0.825rem;">
                                        {{profile.stage_name == 'stage_5' ? profile.stage_data.program : 'Belum Ditelaah'}}
                                    </td>
                                    <td class="text-nowrap">
                                        {{profile.stage_name == 'stage_5' ? profile.stage_data.schedule : 'Belum Ditelaah'}}
                                    </td>
                                    <td class="fw-bold text-dark text-nowrap" style="font-size: 0.825rem;">
                                        {{profile.stage_name == 'stage_5' ? profile.stage_data.results : 'Belum Ditelaah'}}
                                    </td>
                                    <td class="text-secondary" style="font-size: 0.825rem;"></td>
                                    <td class="text-center">
                                        <div class="d-flex align-items-center justify-content-center gap-2">
                                        @if(profile.stage_name != 'stage_5')
                                        <a href="/kpm/profiles/{{profile.id}}/telaah" router-link class="btn btn-action-outline">Telaah</a>
                                        @endif
                                        </div>
                                    </td>
                                </tr>
                                @endfor

                                @if(data.profiles.length == 0)
                                <tr>
                                    <td colspan="8">
                                        <div class="p-3 text-center">
                                            <i>Tidak ada data</i>
                                        </div>
                                    </td>
                                </tr>
                                @endif
                            </tbody>
                        </table>
                    </div>

                </div>

                <!-- Left Alert Note -->
                <div class="info-alert">
                    <i class="bi bi-info-circle-fill"></i>
                    <div>OPD/PIC hanya dapat mengakses dan memperbarui rujukan yang menjadi kewenangannya.</div>
                </div>

            </div>

            <div class="col-lg-4">
                <div class="card-custom p-3 mb-3">
                    
                    <!-- Selected Referral Info -->
                    <h6 class="fw-bold mb-3 text-primary" style="color: #1d4ed8 !important;">Rujukan Terpilih</h6>
                    <div id="selectedInfoBox" class="mb-4">
                        <div class="detail-kv-row">
                            <div class="detail-kv-key">Nomor Rujukan</div>
                            <div class="detail-kv-val" id="det-no">: RJ-2026-0001</div>
                        </div>
                        <div class="detail-kv-row">
                            <div class="detail-kv-key">Sumber</div>
                            <div class="detail-kv-val" id="det-sumber">: Dinas Sosial</div>
                        </div>
                        <div class="detail-kv-row">
                            <div class="detail-kv-key">ID KPM</div>
                            <div class="detail-kv-val" id="det-id">: AST-KAB-0001</div>
                        </div>
                        <div class="detail-kv-row">
                            <div class="detail-kv-key">KPM</div>
                            <div class="detail-kv-val" id="det-kpm">: SUGOYONO</div>
                        </div>
                        <div class="detail-kv-row">
                            <div class="detail-kv-key">Kebutuhan</div>
                            <div class="detail-kv-val" id="det-kebutuhan">: Penguatan usaha tani</div>
                        </div>
                        <div class="detail-kv-row">
                            <div class="detail-kv-key">Indikator</div>
                            <div class="detail-kv-val" id="det-indikator">: Produksi meningkat</div>
                        </div>
                        <div class="detail-kv-row">
                            <div class="detail-kv-key">Target Waktu</div>
                            <div class="detail-kv-val" id="det-target">: 30 Hari</div>
                        </div>
                    </div>

                    <hr class="my-3 text-muted" style="opacity: 0.15;">

                    <!-- Intervention Realization Form -->
                    <h6 class="fw-bold mb-3 text-primary" style="color: #1d4ed8 !important;">Realisasi Intervensi</h6>
                    
                    <form id="interventionForm" onsubmit="event.preventDefault();">
                        <!-- Tanggal Pelaksanaan -->
                        <div class="mb-2.5">
                            <label class="form-label form-label-required small fw-medium mb-1">Tanggal Pelaksanaan</label>
                            <div class="input-group input-group-sm">
                                <input type="date" class="form-control" id="formTanggal" value="2026-03-15">
                                <span class="input-group-text bg-white"><i class="bi bi-calendar3 text-primary"></i></span>
                            </div>
                        </div>

                        <!-- Program / Kegiatan -->
                        <div class="mb-2.5 mt-2">
                            <label class="form-label form-label-required small fw-medium mb-1">Program/Kegiatan</label>
                            <select class="form-select form-select-sm" id="formProgram">
                                <option value="Pendampingan usaha" selected>Pendampingan usaha</option>
                                <option value="Fasilitasi program">Fasilitasi program</option>
                                <option value="Pembinaan kelompok">Pembinaan kelompok</option>
                                <option value="Pelatihan Keterampilan">Pelatihan Keterampilan</option>
                            </select>
                        </div>

                        <!-- Hasil Awal -->
                        <div class="mb-2.5 mt-2">
                            <label class="form-label form-label-required small fw-medium mb-1">Hasil Awal</label>
                            <textarea class="form-control form-control-sm" id="formHasil" rows="2">KPM mulai menerapkan teknik budidaya yang disarankan.</textarea>
                        </div>

                        <!-- Kendala -->
                        <div class="mb-2.5 mt-2">
                            <label class="form-label small fw-medium mb-1">Kendala</label>
                            <textarea class="form-control form-control-sm" id="formKendala" rows="2" placeholder="Tuliskan kendala bila ada...">Keterbatasan akses sarana produksi.</textarea>
                        </div>

                        <!-- Tindak Lanjut -->
                        <div class="mb-2.5 mt-2">
                            <label class="form-label small fw-medium mb-1">Tindak Lanjut</label>
                            <textarea class="form-control form-control-sm" id="formTindakLanjut" rows="2" placeholder="Rencana tindak lanjut...">Koordinasi dengan penyuluh untuk pendampingan lanjutan.</textarea>
                        </div>

                        <!-- Bukti Layanan File Drop Zone -->
                        <div class="mb-3 mt-2">
                            <label class="form-label small fw-medium mb-1">Bukti Layanan</label>
                            <div class="upload-box" id="dropZone" onclick="document.getElementById('fileInput').click();">
                                <i class="bi bi-cloud-arrow-up text-primary fs-4"></i>
                                <div class="text-primary fw-medium small mt-1">Pilih file, atau seret ke sini</div>
                                <div class="text-muted" style="font-size: 0.7rem;">PDF, JPG, PNG (maks. 10 MB)</div>
                                <input type="file" id="fileInput" class="d-none" accept=".pdf,.jpg,.jpeg,.png">
                                <div id="fileNameDisplay" class="mt-1 text-success fw-bold small d-none"></div>
                            </div>
                        </div>

                        <!-- Bottom Action Buttons -->
                        <div class="d-flex gap-1.5 justify-content-between">
                            <button type="button" class="btn btn-sm btn-success flex-fill px-1" onclick="updateReferralStatus('Terima')">Terima Rujukan</button>
                            <button type="button" class="btn btn-sm btn-primary flex-fill px-1" onclick="updateReferralStatus('Jadwalkan')">Jadwalkan</button>
                            <button type="button" class="btn btn-sm btn-primary flex-fill px-1" onclick="updateReferralStatus('Selesai')">Catat Realisasi</button>
                        </div>
                    </form>
                </div>

                <!-- Right Sidebar Info Alert -->
                <div class="info-alert">
                    <i class="bi bi-info-circle-fill"></i>
                    <div>Perubahan status otomatis tampil pada Dashboard Utama Dinas Sosial.</div>
                </div>
            </div>
        </div>
    </div>