    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

    <style>
        :root {
            --bg-canvas: #f0f4f9;
            --card-shadow: 0 4px 12px rgba(0, 0, 0, 0.03);
            --card-radius: 12px;
            
            /* Metric Colors */
            --metric-green-bg: #e8f7f0;
            --metric-green-text: #0d8a4f;
            --metric-blue-bg: #eaf2ff;
            --metric-blue-text: #2563eb;
            --metric-orange-bg: #fff7ed;
            --metric-orange-text: #d97706;
            --metric-red-bg: #fef2f2;
            --metric-red-text: #dc2626;

            /* Status Colors */
            --status-green: #22c55e;
            --status-green-light: #dcfce7;
            --status-yellow: #f59e0b;
            --status-yellow-light: #fef3c7;
            --status-red: #ef4444;
            --status-red-light: #fee2e2;

            /* ASTABRATA Primary Palette */
            --ast-navy: #1e3a8a;
            --ast-blue: #3b82f6;
            --ast-purple: #6366f1;
            --ast-dark-blue: #1d4ed8;
        }

        /* Card Styling */
        .card-custom {
            background: #ffffff;
            border-radius: var(--card-radius);
            border: 1px solid #e2e8f0;
            box-shadow: var(--card-shadow);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .card-custom:hover {
            box-shadow: 0 6px 16px rgba(0,0,0,0.06);
        }

        /* KPI Metric Cards */
        .kpi-card {
            border: none;
            border-radius: var(--card-radius);
            padding: 1.25rem 1rem;
            display: flex;
            align-items: center;
            gap: 1rem;
            height: 100%;
        }

        .kpi-icon-box {
            width: 58px;
            height: 58px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.6rem;
            flex-shrink: 0;
        }

        .kpi-green { background-color: var(--metric-green-bg); color: var(--metric-green-text); }
        .kpi-green .kpi-icon-box { background-color: var(--metric-green-text); color: white; }

        .kpi-blue { background-color: var(--metric-blue-bg); color: var(--metric-blue-text); }
        .kpi-blue .kpi-icon-box { background-color: var(--metric-blue-text); color: white; }

        .kpi-orange { background-color: var(--metric-orange-bg); color: var(--metric-orange-text); }
        .kpi-orange .kpi-icon-box { background-color: var(--metric-orange-text); color: white; }

        .kpi-red { background-color: var(--metric-red-bg); color: var(--metric-red-text); }
        .kpi-red .kpi-icon-box { background-color: var(--metric-red-text); color: white; }

        .kpi-title {
            font-size: 0.95rem;
            font-weight: 700;
            margin-bottom: 0.1rem;
            color: #334155;
        }

        .kpi-value {
            font-size: 2.1rem;
            font-weight: 800;
            line-height: 1;
        }

        .kpi-sub {
            font-size: 0.75rem;
            font-weight: 600;
            margin-top: 0.35rem;
            opacity: 0.85;
        }

        /* Card Section Header */
        .card-header-title {
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--ast-navy);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        /* Flow Pipeline Styles */
        .pipeline-container {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            overflow-x: auto;
            padding: 1rem 0;
            position: relative;
        }

        .pipeline-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            min-width: 72px;
            flex: 1;
            position: relative;
        }

        .pipeline-icon-wrapper {
            position: relative;
            z-index: 2;
        }

        .pipeline-circle {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background-color: #3b82f6;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            box-shadow: 0 3px 6px rgba(59, 130, 246, 0.25);
            margin: 0 auto;
        }

        .pipeline-arrow {
            position: absolute;
            top: 14px;
            right: -25%;
            font-size: 0.9rem;
            color: #94a3b8;
            z-index: 1;
        }

        .pipeline-label {
            font-size: 0.8rem;
            font-weight: 700;
            color: #1e293b;
            margin-top: 0.5rem;
        }

        .pipeline-val {
            font-size: 1.1rem;
            font-weight: 800;
            color: var(--ast-navy);
            margin-top: 0.1rem;
        }

        .pipeline-desc {
            font-size: 0.65rem;
            color: #64748b;
            margin-top: 0.25rem;
            line-height: 1.2;
            padding: 0 2px;
        }

        /* Kecamatans Grid */
        .kec-grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 6px;
        }

        .kec-box {
            aspect-ratio: 1;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.85rem;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .kec-box:hover {
            transform: scale(1.08);
            z-index: 3;
            box-shadow: 0 4px 8px rgba(0,0,0,0.15);
        }

        .kec-green { background-color: #bbf7d0; color: #15803d; }
        .kec-yellow { background-color: #fef08a; color: #a16207; }
        .kec-red { background-color: #fca5a5; color: #b91c1c; }

        .kec-legend {
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 0.72rem;
            font-weight: 600;
            color: #475569;
            margin-top: 0.75rem;
            flex-wrap: wrap;
            gap: 0.3rem;
        }

        .legend-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            display: inline-block;
            margin-right: 4px;
        }

        /* Action Buttons */
        .btn-action-custom {
            display: flex;
            align-items: center;
            justify-content: flex-start;
            gap: 0.75rem;
            padding: 0.75rem 1rem;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.9rem;
            color: white;
            border: none;
            width: 100%;
            transition: all 0.2s ease;
            text-align: left;
            text-decoration: none;
        }

        .btn-action-custom:hover {
            opacity: 0.92;
            transform: translateY(-1px);
            color: white;
        }

        .btn-act-blue { background-color: #2563eb; }
        .btn-act-green { background-color: #16a34a; }
        .btn-act-purple { background-color: #6366f1; }
        .btn-act-dark { background-color: #1e3a8a; }
        .btn-act-outline {
            background-color: #ffffff;
            color: #2563eb;
            border: 1px solid #bfdbfe;
        }
        .btn-act-outline:hover {
            background-color: #eff6ff;
            color: #1d4ed8;
        }

        /* Impact Indicators */
        .impact-grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 8px;
            margin-top: 0.5rem;
        }

        .impact-card {
            border-radius: 8px;
            padding: 0.6rem 0.3rem;
            text-align: center;
            font-size: 0.72rem;
            font-weight: 700;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 0.4rem;
            min-height: 90px;
            line-height: 1.25;
        }

        .impact-card i {
            font-size: 1.4rem;
        }

        .impact-1 { background-color: #dcfce7; color: #166534; }
        .impact-2 { background-color: #dbeafe; color: #1e40af; }
        .impact-3 { background-color: #ffedd5; color: #9a3412; }
        .impact-4 { background-color: #f3e8ff; color: #6b21a8; }
        .impact-5 { background-color: #ccfbf1; color: #115e59; }

        /* Alert Boxes */
        .alert-box {
            border-radius: 10px;
            padding: 0.85rem 1rem;
            display: flex;
            align-items: flex-start;
            gap: 0.85rem;
            font-size: 0.82rem;
            font-weight: 600;
            line-height: 1.4;
        }

        .alert-box-red {
            background-color: #fef2f2;
            border: 1px solid #fecaca;
            color: #991b1b;
        }

        .alert-box-blue {
            background-color: #eff6ff;
            border: 1px solid #bfdbfe;
            color: #1e40af;
        }

        .alert-box-icon {
            font-size: 1.4rem;
            flex-shrink: 0;
            margin-top: -2px;
        }

        /* Bottom Banner */
        .bottom-banner {
            background: linear-gradient(90deg, #1e3a8a 0%, #2563eb 100%);
            color: white;
            border-radius: 8px;
            padding: 0.75rem 1.25rem;
            font-size: 0.85rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 4px 10px rgba(30, 58, 138, 0.2);
        }

        /* Custom Table */
        .table-custom {
            vertical-align: middle;
            font-size: 0.83rem;
            margin-bottom: 0;
        }

        .table-custom th {
            background-color: #f8fafc;
            color: #475569;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 0.72rem;
            letter-spacing: 0.5px;
            border-bottom: 1px solid #e2e8f0;
            padding: 0.65rem 0.75rem;
        }

        .table-custom td {
            padding: 0.65rem 0.75rem;
            border-bottom: 1px solid #f1f5f9;
        }

        .badge-status {
            padding: 0.35em 0.7em;
            font-size: 0.75rem;
            font-weight: 700;
            border-radius: 6px;
        }

        .badge-status-green {
            background-color: #dcfce7;
            color: #15803d;
        }

        .badge-status-yellow {
            background-color: #fef3c7;
            color: #b45309;
        }

        .link-action {
            color: #2563eb;
            text-decoration: none;
            font-weight: 600;
        }

        .link-action:hover {
            text-decoration: underline;
        }

        @media (max-width: 991.98px) {
            .kec-grid {
                grid-template-columns: repeat(5, 1fr);
            }
            .impact-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        @media (max-width: 576px) {
            .impact-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            .bottom-banner {
                flex-direction: column;
                align-items: flex-start;
                gap: 0.5rem;
            }
        }
    </style>
    

<div class="container-fluid p-0">
    
    <!-- HEADER SECTION -->
    <div class="row align-items-center mb-3 g-2">
        <div class="col-md-8">
            <h1 class="h3 fw-extrabold mb-0 text-dark" style="letter-spacing: -0.5px;">
                Beranda Utama Dashboard <span style="color: var(--ast-navy);">ASTABRATA</span>
            </h1>
            <p class="text-secondary small fw-semibold mb-0">
                Rekap Kabupaten &bull; Pengendalian Capaian &bull; Evaluasi Dampak &bull; Pelaporan
            </p>
        </div>
        <div class="col-md-4 text-md-end">
            <div class="d-inline-block text-start">
                <div class="fw-bold text-dark" style="font-size: 0.95rem;">Dinas Sosial Kabupaten Asahan</div>
                <div class="text-secondary small fw-semibold">
                    <i class="fa-regular fa-calendar-check me-1 text-primary"></i> Data diperbarui: <span class="text-dark">18 Sep 2026</span>
                </div>
            </div>
        </div>
    </div>

    <!-- TOP KPI SUMMARY CARDS -->
    <div class="row g-3 mb-3">
        <!-- 1. Cakupan Kecamatan -->
        <div class="col-xl-3 col-md-6">
            <div class="kpi-card kpi-green">
                <div class="kpi-icon-box">
                    <i class="fa-solid fa-location-dot"></i>
                </div>
                <div>
                    <div class="kpi-title">Cakupan Kecamatan</div>
                    <div class="kpi-value">25</div>
                </div>
            </div>
        </div>

        <!-- 2. Desa/Keluruhan -->
        <div class="col-xl-3 col-md-6">
            <div class="kpi-card kpi-blue">
                <div class="kpi-icon-box">
                    <i class="fa-solid fa-users"></i>
                </div>
                <div>
                    <div class="kpi-title">Desa/Keluruhan</div>
                    <div class="kpi-value">204</div>
                </div>
            </div>
        </div>

        <!-- 3. KPM Terdata -->
        <div class="col-xl-3 col-md-6">
            <div class="kpi-card kpi-orange">
                <div class="kpi-icon-box">
                    <i class="fa-solid fa-people-group"></i>
                </div>
                <div>
                    <div class="kpi-title">KPM Terdata</div>
                    <div class="kpi-value">63</div>
                    <div class="kpi-sub">Target minimal 100 KPM</div>
                </div>
            </div>
        </div>

        <!-- 4. Kekurangan Target -->
        <div class="col-xl-3 col-md-6">
            <div class="kpi-card kpi-red">
                <div class="kpi-icon-box">
                    <i class="fa-solid fa-circle-exclamation"></i>
                </div>
                <div>
                    <div class="kpi-title">Kekurangan Target</div>
                    <div class="kpi-value">37</div>
                    <div class="kpi-sub">Capaian awal 63%</div>
                </div>
            </div>
        </div>
    </div>

    <!-- MAIN CONTENT GRID -->
    <div class="row g-3">
        
        <!-- LEFT COLUMN (WIDE) -->
        <div class="col-xl-6 col-lg-12">
            
            <!-- 1. Alur KPM Kabupaten Card -->
            <div class="card-custom p-3 mb-3">
                <div class="card-header-title mb-2">
                    <i class="fa-regular fa-file-lines text-primary"></i>
                    <span>Alur KPM Kabupaten</span>
                </div>

                <div class="pipeline-container">
                    <!-- Step 1 -->
                    <div class="pipeline-item">
                        <div class="pipeline-icon-wrapper">
                            <div class="pipeline-circle"><i class="fa-regular fa-file-text"></i></div>
                            <i class="fa-solid fa-chevron-right pipeline-arrow"></i>
                        </div>
                        <div class="pipeline-label">Usulan</div>
                        <div class="pipeline-val">63</div>
                        <div class="pipeline-desc">Terisi otomatis sesuai proses</div>
                    </div>

                    <!-- Step 2 -->
                    <div class="pipeline-item">
                        <div class="pipeline-icon-wrapper">
                            <div class="pipeline-circle"><i class="fa-solid fa-user-check"></i></div>
                            <i class="fa-solid fa-chevron-right pipeline-arrow"></i>
                        </div>
                        <div class="pipeline-label">Verifikasi</div>
                        <div class="pipeline-val">&mdash;</div>
                        <div class="pipeline-desc">Terisi otomatis sesuai proses</div>
                    </div>

                    <!-- Step 3 -->
                    <div class="pipeline-item">
                        <div class="pipeline-icon-wrapper">
                            <div class="pipeline-circle"><i class="fa-solid fa-user-pen"></i></div>
                            <i class="fa-solid fa-chevron-right pipeline-arrow"></i>
                        </div>
                        <div class="pipeline-label">Asesmen</div>
                        <div class="pipeline-val">&mdash;</div>
                        <div class="pipeline-desc">Terisi otomatis sesuai proses</div>
                    </div>

                    <!-- Step 4 -->
                    <div class="pipeline-item">
                        <div class="pipeline-icon-wrapper">
                            <div class="pipeline-circle"><i class="fa-regular fa-clipboard"></i></div>
                            <i class="fa-solid fa-chevron-right pipeline-arrow"></i>
                        </div>
                        <div class="pipeline-label">RII</div>
                        <div class="pipeline-val">&mdash;</div>
                        <div class="pipeline-desc">Terisi otomatis sesuai proses</div>
                    </div>

                    <!-- Step 5 -->
                    <div class="pipeline-item">
                        <div class="pipeline-icon-wrapper">
                            <div class="pipeline-circle"><i class="fa-solid fa-house-chimney"></i></div>
                            <i class="fa-solid fa-chevron-right pipeline-arrow"></i>
                        </div>
                        <div class="pipeline-label">Intervensi</div>
                        <div class="pipeline-val">&mdash;</div>
                        <div class="pipeline-desc">Terisi otomatis sesuai proses</div>
                    </div>

                    <!-- Step 6 -->
                    <div class="pipeline-item">
                        <div class="pipeline-icon-wrapper">
                            <div class="pipeline-circle"><i class="fa-regular fa-file-code"></i></div>
                            <i class="fa-solid fa-chevron-right pipeline-arrow"></i>
                        </div>
                        <div class="pipeline-label">Monev</div>
                        <div class="pipeline-val">&mdash;</div>
                        <div class="pipeline-desc">Terisi otomatis sesuai proses</div>
                    </div>

                    <!-- Step 7 -->
                    <div class="pipeline-item">
                        <div class="pipeline-icon-wrapper">
                            <div class="pipeline-circle"><i class="fa-solid fa-user-tie"></i></div>
                            <i class="fa-solid fa-chevron-right pipeline-arrow"></i>
                        </div>
                        <div class="pipeline-label">Graduasi</div>
                        <div class="pipeline-val">&mdash;</div>
                        <div class="pipeline-desc">Terisi otomatis sesuai proses</div>
                    </div>

                    <!-- Step 8 -->
                    <div class="pipeline-item">
                        <div class="pipeline-icon-wrapper">
                            <div class="pipeline-circle"><i class="fa-regular fa-folder-open"></i></div>
                            <i class="fa-solid fa-chevron-right pipeline-arrow"></i>
                        </div>
                        <div class="pipeline-label">UEP</div>
                        <div class="pipeline-val">&mdash;</div>
                        <div class="pipeline-desc">Terisi otomatis sesuai proses</div>
                    </div>

                    <!-- Step 9 -->
                    <div class="pipeline-item">
                        <div class="pipeline-icon-wrapper">
                            <div class="pipeline-circle"><i class="fa-solid fa-graduation-cap"></i></div>
                        </div>
                        <div class="pipeline-label">Pascagraduasi</div>
                        <div class="pipeline-val">&mdash;</div>
                        <div class="pipeline-desc">Terisi otomatis sesuai proses</div>
                    </div>
                </div>
            </div>

            <!-- 2. Konvergensi Intervensi OPD Card -->
            <div class="card-custom p-3">
                <div class="card-header-title mb-3">
                    <i class="fa-solid fa-building-columns text-primary"></i>
                    <span>Konvergensi Intervensi OPD</span>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover table-custom align-middle">
                        <thead>
                            <tr>
                                <th>OPD/PIC</th>
                                <th>Jenis Intervensi</th>
                                <th>KPM</th>
                                <th>Status</th>
                                <th>Kendala</th>
                                <th>Tindak Lanjut</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="fw-bold">Dinas Pertanian</td>
                                <td>Penguatan usaha tani</td>
                                <td>Data Aktual</td>
                                <td><span class="badge-status badge-status-green">Berjalan</span></td>
                                <td><a href="#" class="link-action">Lihat detail</a></td>
                                <td class="fw-semibold">Koordinasi</td>
                            </tr>
                            <tr>
                                <td class="fw-bold">Dinas Perikanan</td>
                                <td>Penguatan usaha perikanan</td>
                                <td>Data Aktual</td>
                                <td><span class="badge-status badge-status-green">Berjalan</span></td>
                                <td><a href="#" class="link-action">Lihat detail</a></td>
                                <td class="fw-semibold">Pendampingan</td>
                            </tr>
                            <tr>
                                <td class="fw-bold">DPMPTSP</td>
                                <td>Fasilitasi perizinan</td>
                                <td>Data Aktual</td>
                                <td><span class="badge-status badge-status-yellow">Proses</span></td>
                                <td><a href="#" class="link-action">Lihat detail</a></td>
                                <td class="fw-semibold">Percepatan</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>

        <!-- MIDDLE COLUMN -->
        <div class="col-xl-3 col-lg-6">
            
            <!-- 1. Rekap 25 Kecamatan Card -->
            <div class="card-custom p-3 mb-3">
                <div class="card-header-title mb-3">
                    <i class="fa-solid fa-map-location-dot text-primary"></i>
                    <span>Rekap 25 Kecamatan</span>
                </div>

                <div class="kec-grid">
                    <!-- 25 Numbered Boxes -->
                    <div class="kec-box kec-green" title="Kecamatan 01: Memenuhi minimal 4 KPM">01</div>
                    <div class="kec-box kec-yellow" title="Kecamatan 02: Masih kurang">02</div>
                    <div class="kec-box kec-yellow" title="Kecamatan 03: Masih kurang">03</div>
                    <div class="kec-box kec-yellow" title="Kecamatan 04: Masih kurang">04</div>
                    <div class="kec-box kec-red" title="Kecamatan 05: Belum mengusulkan">05</div>

                    <div class="kec-box kec-green" title="Kecamatan 06: Memenuhi minimal 4 KPM">06</div>
                    <div class="kec-box kec-green" title="Kecamatan 07: Memenuhi minimal 4 KPM">07</div>
                    <div class="kec-box kec-yellow" title="Kecamatan 08: Masih kurang">08</div>
                    <div class="kec-box kec-red" title="Kecamatan 09: Belum mengusulkan">09</div>
                    <div class="kec-box kec-green" title="Kecamatan 10: Memenuhi minimal 4 KPM">10</div>

                    <div class="kec-box kec-yellow" title="Kecamatan 11: Masih kurang">11</div>
                    <div class="kec-box kec-green" title="Kecamatan 12: Memenuhi minimal 4 KPM">12</div>
                    <div class="kec-box kec-green" title="Kecamatan 13: Memenuhi minimal 4 KPM">13</div>
                    <div class="kec-box kec-yellow" title="Kecamatan 14: Masih kurang">14</div>
                    <div class="kec-box kec-green" title="Kecamatan 15: Memenuhi minimal 4 KPM">15</div>

                    <div class="kec-box kec-red" title="Kecamatan 16: Belum mengusulkan">16</div>
                    <div class="kec-box kec-green" title="Kecamatan 17: Memenuhi minimal 4 KPM">17</div>
                    <div class="kec-box kec-yellow" title="Kecamatan 18: Masih kurang">18</div>
                    <div class="kec-box kec-green" title="Kecamatan 19: Memenuhi minimal 4 KPM">19</div>
                    <div class="kec-box kec-green" title="Kecamatan 20: Memenuhi minimal 4 KPM">20</div>

                    <div class="kec-box kec-green" title="Kecamatan 21: Memenuhi minimal 4 KPM">21</div>
                    <div class="kec-box kec-yellow" title="Kecamatan 22: Masih kurang">22</div>
                    <div class="kec-box kec-red" title="Kecamatan 23: Belum mengusulkan">23</div>
                    <div class="kec-box kec-green" title="Kecamatan 24: Memenuhi minimal 4 KPM">24</div>
                    <div class="kec-box kec-yellow" title="Kecamatan 25: Masih kurang">25</div>
                </div>

                <!-- Legend -->
                <div class="kec-legend">
                    <div><span class="legend-dot" style="background-color: var(--status-green);"></span>Memenuhi min 4 KPM</div>
                    <div><span class="legend-dot" style="background-color: var(--status-yellow);"></span>Masih kurang</div>
                    <div><span class="legend-dot" style="background-color: var(--status-red);"></span>Belum mengusulkan</div>
                </div>

                <!-- Button -->
                <div class="mt-3">
                    <button class="btn btn-outline-primary btn-sm w-100 fw-bold py-2 rounded-3" style="border-color: #cbd5e1; color: #1e3a8a;">
                        <i class="fa-solid fa-chart-column me-1"></i> Lihat Rekap Kecamatan
                    </button>
                </div>
            </div>

            <!-- 2. Indikator Dampak Card -->
            <div class="card-custom p-3">
                <div class="card-header-title">
                    <i class="fa-solid fa-chart-line text-primary"></i>
                    <span>Indikator Dampak</span>
                </div>
                <div class="text-secondary small fw-semibold mb-2" style="font-size: 0.72rem;">
                    Baseline dibandingkan dengan kondisi akhir
                </div>

                <div class="impact-grid">
                    <div class="impact-card impact-1">
                        <i class="fa-solid fa-chart-line-up"></i>
                        <span>Perubahan Pendapatan</span>
                    </div>
                    <div class="impact-card impact-2">
                        <i class="fa-solid fa-store"></i>
                        <span>Keberlanjutan Usaha</span>
                    </div>
                    <div class="impact-card impact-3">
                        <i class="fa-solid fa-hands-holding-child"></i>
                        <span>Akses Layanan Sosial</span>
                    </div>
                    <div class="impact-card impact-4">
                        <i class="fa-solid fa-graduation-cap"></i>
                        <span>Capaian Graduasi</span>
                    </div>
                    <div class="impact-card impact-5">
                        <i class="fa-solid fa-shield-halved"></i>
                        <span>Ketahanan Pascagraduasi</span>
                    </div>
                </div>

                <!-- Button -->
                <div class="mt-3">
                    <button class="btn btn-outline-primary btn-sm w-100 fw-bold py-2 rounded-3" style="border-color: #cbd5e1; color: #1e3a8a;">
                        <i class="fa-solid fa-chart-simple me-1"></i> Lihat Evaluasi Dampak
                    </button>
                </div>
            </div>

        </div>

        <!-- RIGHT COLUMN -->
        <div class="col-xl-3 col-lg-6">
            
            <!-- 1. Laporan dan Ketertelusuran Card -->
            <div class="card-custom p-3 mb-3">
                <div class="card-header-title mb-3">
                    <i class="fa-regular fa-file-lines text-primary"></i>
                    <span>Laporan dan Ketertelusuran</span>
                </div>

                <div class="d-flex flex-column gap-2">
                    <a href="#" class="btn-action-custom btn-act-blue">
                        <i class="fa-solid fa-print"></i>
                        <span>Cetak Laporan Implementasi</span>
                    </a>
                    <a href="#" class="btn-action-custom btn-act-green">
                        <i class="fa-solid fa-file-excel"></i>
                        <span>Ekspor Rekap Kabupaten</span>
                    </a>
                    <a href="#" class="btn-action-custom btn-act-purple">
                        <i class="fa-solid fa-database"></i>
                        <span>Register Bukti</span>
                    </a>
                    <a href="#" class="btn-action-custom btn-act-dark">
                        <i class="fa-solid fa-file-contract"></i>
                        <span>Audit Trail</span>
                    </a>
                    <a href="#" class="btn-action-custom btn-act-outline">
                        <i class="fa-solid fa-list-check"></i>
                        <span>Daftar Tindak Lanjut</span>
                    </a>
                </div>
            </div>

            <!-- 2. Perlu Perhatian Alert -->
            <div class="alert-box alert-box-red mb-3">
                <i class="fa-solid fa-circle-exclamation alert-box-icon text-danger"></i>
                <div>
                    <div class="fw-extrabold mb-1" style="font-size: 0.88rem; color: #991b1b;">Perlu Perhatian</div>
                    Target minimal 4 KPM pada setiap kecamatan dan minimal 100 KPM tingkat kabupaten.
                </div>
            </div>

            <!-- 3. Informasi Alert -->
            <div class="alert-box alert-box-blue">
                <i class="fa-solid fa-circle-info alert-box-icon text-primary"></i>
                <div>
                    <div class="fw-extrabold mb-1" style="font-size: 0.88rem; color: #1e40af;">Informasi</div>
                    Seluruh data ditarik otomatis dari halaman Desa/Keluruhan, Pendamping PKH/TKSK, Kecamatan, OPD/PIC, dan rekam KPM.
                </div>
            </div>

        </div>

    </div>

    <!-- BOTTOM BANNER -->
    <div class="row mt-3">
        <div class="col-12">
            <div class="bottom-banner">
                <div class="d-flex align-items-center gap-2">
                    <div class="bg-white text-primary rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 22px; height: 22px; font-size: 0.75rem;">
                        <i class="fa-solid fa-check"></i>
                    </div>
                    <span>Setiap data, bukti, petugas, waktu, perubahan status, dan keputusan tercatat dalam register ketertelusuran.</span>
                </div>
                <div class="opacity-90 fw-semibold text-nowrap">
                    Satu ID dan satu rekam per KPM.
                </div>
            </div>
        </div>
    </div>

</div>