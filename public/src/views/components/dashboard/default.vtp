<div class="container-fluid py-4">

    <!-- Page Title -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Dashboard</h2>
            <p class="text-muted mb-0">
                Welcome back to Admin Panel.
            </p>
        </div>
    </div>

    <div class="row g-4">

        <!-- Welcome -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-0">
                <div class="card-body p-4">
                    <h5 class="fw-semibold mb-3">
                        Welcome 👋
                    </h5>

                    <p class="text-muted mb-0">
                        Please use sidebar menu to manage all the application data. make sure all of updated is checked and saved.
                    </p>
                </div>
            </div>
        </div>

        <!-- User Info -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 rounded-0">
                <div class="card-header detail-header d-flex justify-content-between align-items-center">
                    <h5 class="detail-title">
                        Account Information
                    </h5>
                </div>
                <div class="card-body">

                    <div class="row detail-row">
                        <div class="col-sm-4 detail-label">Name</div>
                        <div class="col-sm-8 detail-value">{{userData.name}}</div>
                    </div>
                    <div class="row detail-row">
                        <div class="col-sm-4 detail-label">Email</div>
                        <div class="col-sm-8 detail-value">{{userData.email}}</div>
                    </div>
                    <div class="row detail-row">
                        <div class="col-sm-4 detail-label">Roles</div>
                        <div class="col-sm-8 detail-value">
                            @for(const role of userData.roles)
                            <span class="badge border text-success-emphasis bg-success-subtle border-success-subtle me-1">{{role.name}}</span>
                            @endfor
                        </div>
                    </div>

                </div>
            </div>
        </div>

    </div>

</div>