<div class="form-group mb-3 {{field.attr && field.attr.wrapperClassName ? field.attr.wrapperClassName : ''}}">
    <label for="" class="fw-semibold mb-1">{{field.label}}</label>
    <div class="input-group mb-3">
        <input type="text" name="{{field.name}}" value="{{data[field.key] ?? ''}}" placeholder="{{field.placeholder ?? field.label}}" class="form-control {{field.attr && field.attr.className ? field.attr.className : ''}}" {{ field.attr ? Object.entries(field.attr).map(([key, value]) => `${key}="${value}"`).join(' ') : '' }} readonly>
        <div class="input-group-append">
            <button class="btn btn-normal btn-outline-secondary" name="{{field.btnName}}" type="button" style="border-top-left-radius: 0px;border-bottom-left-radius: 0;height: 100%;">Get Location</button>
        </div>
    </div>
</div>