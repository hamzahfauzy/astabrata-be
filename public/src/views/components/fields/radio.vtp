<div class="form-group mb-3">
    <label for="" class="fw-semibold mb-1">{{field.label}}</label>

    <div class="d-flex flex-wrap gap-2">
        @for(const [index, option] of field.options.entries())
        <div class="form-check">
            <input id="{{field.name + index}}" name="{{field.name}}" {{data && data[field.key] && data[field.key].includes(option) ? 'checked=""' : ''}} value="{{option}}" type="radio" class="form-check-input">
            <label for="{{field.name + index}}" class="form-check-label">{{ option }}</label>
        </div>
        @endfor
    </div>
</div>