<!-- Header -->
<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-2">
            <li class="breadcrumb-item">
                <a href="/" router-link>Dashboard</a>
            </li>
            @component('breadcrumb', {
                breadcrumbs: [
                    {label: 'Profil', route: '/profile'}
                ],
                title: 'Perbaharui Profil'
            })
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h2 class="fw-bold mb-1">
                Perbaharui Profil
            </h2>
            <p class="text-muted mb-0">
                Ubah nilai pada form untuk memperbaharui profil
            </p>
        </div>
    </div>
</div>

<!-- Table Card -->
<div class="card shadow-sm mb-4 rounded-0">
    <form id="update-profile-form" method="post" class="m-0">
        <div class="card-body p-3 mt-3">
            @for(const field of fields)
            @component('vtp-input', {
                field, data: userData
            })
            @endfor
        </div>
        <div class="card-footer p-3">
            <button class="btn btn-normal btn-success btn-submit rounded-0">Submit</button>
            <a href="/profile" class="btn btn-normal btn-secondary rounded-0" router-link>Batal</a>
        </div>
    </form>
</div>