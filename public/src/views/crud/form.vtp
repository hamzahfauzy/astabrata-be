<!-- Header -->
<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-2">
            <li class="breadcrumb-item">
                <a href="/" router-link>Dashboard</a>
            </li>
            @component('breadcrumb', {
                breadcrumbs: pageAttr.breadcrumbs,
                title: pageAttr.title
            })
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h2 class="fw-bold mb-1">
                {{pageAttr.title}}
            </h2>
            <p class="text-muted mb-0">
                {{pageAttr.subtitle}}
            </p>
        </div>
    </div>
</div>

<!-- Table Card -->
<div class="card shadow-sm mb-4 rounded-0">
    <form id="crud-form" method="post" class="m-0">
        <div class="card-body p-3 mt-3">
            @for(const field of pageAttr.fields)
            @component('vtp-input', {
                field, data
            })
            @endfor
        </div>
        <div class="card-footer p-3">
            <button class="btn btn-normal rounded-0 btn-success">Submit</button>
            <a href="{{ baseUrl }}" class="btn btn-normal rounded-0 btn-secondary" router-link>Batal</a>
        </div>
    </form>
</div>