
<!-- Login Card -->
<div class="card border-0 rounded-0 w-100" style="max-width: 440px;">
    <div class="card-body p-4 p-sm-5">

        <!-- Logo Header -->
        <div class="text-center w-100 mb-4">
            <img src="/assets/images/astabrata-logo.png" alt="company-logo" style="width:250px;object-fit: contain;object-position: left;">
        </div>

        
        <!-- Title -->
        <h4 class="text-center fw-bold mb-1" style="color: var(--text-dark);">Lupa Kata sandi</h4>
        <p class="text-center mb-4" style="color: var(--text-muted); font-size: 0.9rem;">Silahkan hubungi administrator untuk meminta kata sandi baru</p>


        <center>
            <a href="/login" class="text-decoration-none fw-semibold small text-brand" router-link>Kembali ke Halaman Masuk</a>
        </center>


    </div>
</div>